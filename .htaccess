# ---- página de error ----
ErrorDocument 404 /404.html

# ---- nunca exponer los leads guardados localmente ----
<Files "leads.jsonl">
  Require all denied
</Files>

# ---- archivos internos del repo (si se despliega con Git, todo el repo
#      termina en public_html: el spec y los metadatos no deben ser públicos) ----
<FilesMatch "\.(md|jsonl|log|yml|yaml|json)$">
  Require all denied
</FilesMatch>
<Files "site.webmanifest">
  Require all granted
</Files>
<Files ".gitignore">
  Require all denied
</Files>
RedirectMatch 404 /\.git

# ---- forzar https y un único host canónico (sin www) ----
# Evita que Google indexe la misma página en cuatro direcciones distintas.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://gruas.com.py/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.gruas\.com\.py$ [NC]
  RewriteRule ^(.*)$ https://gruas.com.py/$1 [R=301,L]
</IfModule>

# ---- compresión ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---- tipos MIME modernos ----
# Apache antiguo no conoce AVIF: sin esto se sirve como octet-stream y el
# navegador descarta el <source> antes de mirarlo.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# ---- caché ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ---- cabeceras de seguridad básicas ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
